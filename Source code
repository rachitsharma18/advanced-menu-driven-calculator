        n1 = float(input("Enter first number: "))
        n2 = float(input("Enter second number: "))
        print(f"Result: {n1} % {n2} = {n1 % n2}")
    elif choice == 6:
        n1 = float(input("Enter base (x): "))
        n2 = float(input("Enter exponent (y): "))
        print(f"Result: {n1} ^ {n2} = {n1 ** n2}")
    elif choice == 7:
        n = float(input("Enter number: "))
        if n < 0:
            print("Error: Cannot calculate real square root of a negative number.")
        else:
            print(f"Square Root of {n} = {math.sqrt(n)}")
    elif choice == 8:
        n = float(input("Enter number: "))
        print(f"Cube Root of {n} = {n ** (1/3)}")
    elif choice == 9:
        n = float(input("Enter number: "))
        print(f"Absolute value of {n} = {abs(n)}")
    elif choice == 10:
        n = int(input("Enter integer: "))
        if n < 0:
            print("Error: Factorial of negative number does not exist.")
        else:
            print(f"Factorial of {n}! = {math.factorial(n)}")
    elif choice == 11:
        n = float(input("Enter number: "))
        if n <= 0:
            print("Error: Logarithm only defined for positive numbers.")
        else:
            print(f"Log10({n}) = {math.log10(n)}")
    elif choice == 12:
        n = float(input("Enter number: "))
        if n <= 0:
            print("Error: Natural logarithm only defined for positive numbers.")
        else:
            print(f"ln({n}) = {math.log(n)}")
            
    # Category 2: Trigonometry & Hyperbolic
    elif choice in [13, 14, 15, 16, 17, 18]:
        deg = float(input("Enter angle in degrees: "))
        rad = math.radians(deg)
        if choice == 13:
            print(f"sin({deg}) = {math.sin(rad)}")
        elif choice == 14:
            print(f"cos({deg}) = {math.cos(rad)}")
        elif choice == 15:
            if deg % 180 == 90:
                print(f"tan({deg}) = Undefined")
            else:
                print(f"tan({deg}) = {math.tan(rad)}")
        elif choice == 16:
            print(f"sinh({deg}) = {math.sinh(rad)}")
        elif choice == 17:
            print(f"cosh({deg}) = {math.cosh(rad)}")
        elif choice == 18:
            print(f"tanh({deg}) = {math.tanh(rad)}")
                
    # Category 3: Matrix Operations
    elif choice == 19:
        m1 = input_matrix_2x2("A")
        m2 = input_matrix_2x2("B")
        res = [[m1[i][j] + m2[i][j] for j in range(2)] for i in range(2)]
        print(f"Resultant Matrix:\n[{res[0][0]}, {res[0][1]}]\n[{res[1][0]}, {res[1][1]}]")
    elif choice == 20:
        m1 = input_matrix_2x2("A")
        m2 = input_matrix_2x2("B")
        res = [[0,0], [0,0]]
        for i in range(2):
            for j in range(2):
                for k in range(2):
                    res[i][j] += m1[i][k] * m2[k][j]
        print(f"Resultant Matrix:\n[{res[0][0]}, {res[0][1]}]\n[{res[1][0]}, {res[1][1]}]")
    elif choice == 21:
        m = input_matrix_2x2("A")
        det = m[0][0]*m[1][1] - m[0][1]*m[1][0]
        print(f"Determinant = {det}")
        
    # Category 4: Equation & Complex Numbers
    elif choice == 22:
        print("Equation: ax + b = 0")
