        print(f"Multiplication: {c1 * c2}")
        
    # Category 5: Financial & Unit Converter
    elif choice == 25:
        p = float(input("Enter Loan Amount: "))
        r = float(input("Enter Annual Interest Rate (%): ")) / (12 * 100)
        t = float(input("Enter Tenure in months: "))
        emi = p * r * (pow(1 + r, t) / (pow(1 + r, t) - 1))
        print(f"Monthly EMI = {emi:.2f}")
    elif choice == 26:
        m_amt = float(input("Enter Monthly SIP Amount: "))
        r = float(input("Enter Expected Annual Return Rate (%): ")) / (12 * 100)
        t = float(input("Enter Time Period in months: "))
        fv = m_amt * ((((1 + r)**t) - 1) / r) * (1 + r)
        print(f"Future Value of Investment = {fv:.2f}")
