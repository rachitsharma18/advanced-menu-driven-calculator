def input_matrix_2x2(name):
    print(f"Enter elements for 2x2 Matrix {name}:")
    a = float(input("Row 1, Col 1: "))
    b = float(input("Row 1, Col 2: "))
    c = float(input("Row 2, Col 1: "))
    d = float(input("Row 2, Col 2: "))
    return [[a, b], [c, d]]

while True:
    show_menu()
    try:
        choice = int(input("\nEnter your choice (0-31): "))
    except ValueError:
        print("Invalid input. Please enter numbers only.")
        continue

    print("-" * 60)
    
    if choice == 0:
        print("Exiting the calculator. Goodbye!")
        break
        
    # Category 1: Arithmetic
    elif choice == 1:
        n1 = float(input("Enter first number: "))
