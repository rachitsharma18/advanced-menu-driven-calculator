        print("1. Celsius to Fahrenheit\n2. Fahrenheit to Celsius")
        tc = int(input("Choice: "))
        val = float(input("Enter temperature value: "))
        if tc == 1:
            print(f"Result: {(val * 9/5) + 32:.2f} F")
        else:
            print(f"Result: {(val - 32) * 5/9:.2f} C")
    elif choice == 28:
        print("1. USD to INR\n2. INR to USD")
        cc = int(input("Choice: "))
        val = float(input("Enter amount: "))
        rate = 85.50  # Variable current estimated benchmark exchange rate
        if cc == 1:
            print(f"Amount in INR = {val * rate:.2f}")
        else:
            print(f"Amount in USD = {val / rate:.2f}")
            
    # Category 6: Stats & Misc
    elif choice == 29:
        print("Enter numbers separated by spaces:")
        data = list(map(float, input().split()))
        if len(data) < 2:
            print("Error: Please enter at least 2 numbers.")
        else:
            mean = sum(data) / len(data)
            variance = sum((x - mean) ** 2 for x in data) / len(data)
            std_dev = math.sqrt(variance)
            print(f"Mean = {mean:.2f}\nVariance = {variance:.2f}\nStandard Deviation = {std_dev:.2f}")
    elif choice == 30:
        total = float(input("Enter total value: "))
        obtained = float(input("Enter obtained value: "))
        print(f"Percentage = {(obtained / total) * 100:.2f}%")
    elif choice == 31:
        n = int(input("Enter n: "))
        r = int(input("Enter r: "))
        if n >= r >= 0:
            nPr = math.factorial(n) // math.factorial(n - r)
            nCr = nPr // math.factorial(r)
            print(f"Permutations (nPr) = {nPr}")
            print(f"Combinations (nCr) = {nCr}")
        else:
            print("Error: Conditions for n and r not met (n >= r >= 0).")
            
    else:
        print("Invalid choice. Please choose between 0 and 31.")
        
    input("\n[Press Enter to continue...]")
